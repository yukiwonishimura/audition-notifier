# --- LINE Messaging API ---
# チャネルアクセストークン（長期）: LINE Developers > 対象チャネル > Messaging API設定
LINE_CHANNEL_ACCESS_TOKEN=

# 送信先のユーザーID（Uから始まる33文字）: 同 Messaging API設定 の「あなたのユーザーID」
LINE_USER_ID=

# --- Claude Code CLI 認証 ---
# `claude setup-token` の出力を貼る。CI では必須。
# ローカルで既に `claude` にログイン済みなら空のままでも動く。
CLAUDE_CODE_OAUTH_TOKEN=

# --- 任意 ---
# 使用モデル（未指定なら sonnet）。上げたいなら opus
CLAUDE_MODEL=
